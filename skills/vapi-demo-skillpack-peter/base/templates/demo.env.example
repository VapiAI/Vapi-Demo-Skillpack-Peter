# vapi-demo intake — fill this in BEFORE any building starts.
# Copy to demo.env in the project folder. NEVER commit it; add demo.env to
# .gitignore in the same step that creates it.

# --- Required ---------------------------------------------------------------

# The PRIVATE api key of the org that owns the agent. Private, not public:
# the builder uses it to pull the full assistant/squad/tool configs, to wire
# serverMessages, and to read call records + artifacts when debugging why a
# panel stays empty. Without it the builder is blind.
VAPI_API_KEY=

# Exactly one of these. Squad wiring touches every member (see Default path).
ASSISTANT_ID=
SQUAD_ID=

# --- Required to demo over the phone -----------------------------------------

# The number callers dial, and its Vapi id. Shown in the dashboard header.
# If the agent has no number yet, decide BEFORE building: attach one, or use
# the web-call button instead (then fill the section below).
PHONE_NUMBER=
PHONE_NUMBER_ID=

# --- Only if the demo uses the web-call button or assistant-request ----------

VAPI_ORG_ID=
# The org PRIVATE key again, read under its own name because the token-minting
# code signs with process.env.VAPI_PRIVATE_KEY specifically, not VAPI_API_KEY.
# Same value as VAPI_API_KEY above — just set both.
VAPI_PRIVATE_KEY=
# The Railway deploy's origin (the https://....up.railway.app URL from
# `railway domain`), set once that exists. Vapi's web SDK checks this against
# the calling page's origin, so it must be the PUBLIC url, not localhost —
# the web-call button only works for real (webhooks included) once the
# assistant is wired to that same deployed URL (see Default path step 9).
# If you want to click the button before deploying just to see the UI wire up,
# set this to http://localhost:<port> temporarily: the button will connect
# audio, but the transcript/tool panels stay empty until the real deploy +
# assistant wiring happens — that gap is expected, not a bug.
PUBLIC_ORIGIN=
